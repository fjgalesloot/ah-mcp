# ah-mcp environment variables
# Copy this file to .env and fill in AH_MCP_TOKEN (or configure OAuth, see
# AH_MCP_OAUTH_ISSUER below). docker-compose.yml reads it
# via env_file; the systemd unit reads it via EnvironmentFile.
#
# The container image already sets AH_TOKENS_PATH=/data/ah-mcp/tokens.json,
# AH_MCP_BIND=0.0.0.0, AH_MCP_PORT=8080 and AH_REMOTE=true — no need to repeat
# them here.

# -----------------------------------------------------------------------------
# AH_MCP_TOKEN
#   Shared secret required to call the MCP HTTP server. Supply it as
#   "Authorization: Bearer <token>" or "?token=<token>".
#   A non-loopback bind (--remote, AH_REMOTE=true or AH_MCP_BIND, and
#   therefore always in the container) requires this or OAuth — startup fails
#   with neither, because the server can read and change your Albert Heijn
#   account. Still accepted when OAuth is on.
#   Prefer the header: query strings end up in proxy logs and browser history.
#   Generate one with: openssl rand -hex 32
# -----------------------------------------------------------------------------
AH_MCP_TOKEN=

# -----------------------------------------------------------------------------
# AH_MCP_ALLOWED_ORIGINS
#   Comma-separated browser origins allowed to call the server. Blocks
#   DNS-rebinding attacks against a loopback server.
#   Setting this replaces the whole default list, which is:
#            AH_MCP_BASE_URL, http://localhost:<port>, http://127.0.0.1:<port>,
#            https://claude.ai, https://claude.com
#   Requests without an Origin header (all non-browser MCP clients) always pass.
#   Set to * to disable the check.
# -----------------------------------------------------------------------------
AH_MCP_ALLOWED_ORIGINS=https://claude.ai,https://claude.com

# -----------------------------------------------------------------------------
# AH_SITE
#   Albert Heijn site to target: "nl" (default) or "be".
# -----------------------------------------------------------------------------
AH_SITE=nl

# =============================================================================
# Optional — everything below has a sensible default.
# =============================================================================

# -----------------------------------------------------------------------------
# AH_CALLBACK_HOST
#   Base URL the OAuth proxy listens on. The user opens this URL in their
#   browser to complete the login flow.
#   Default: http://127.0.0.1:9876
#   In Docker this default only works from a browser on the Docker host itself.
#   From elsewhere, use the URL that reaches port 9876 on the host, ideally
#   through a TLS reverse proxy: https://ah-login.example.com
#   Do not use "localhost": hCaptcha refuses that hostname and the AH login
#   page then fails with "Kon de captcha controle niet laden".
# -----------------------------------------------------------------------------
# AH_CALLBACK_HOST=http://127.0.0.1:9876

# -----------------------------------------------------------------------------
# AH_CALLBACK_PORT
#   Port the temporary OAuth reverse-proxy server binds to during login.
#   Must match the port in AH_CALLBACK_HOST for local deployments.
#   Default: 9876
# -----------------------------------------------------------------------------
# AH_CALLBACK_PORT=9876

# -----------------------------------------------------------------------------
# AH_MCP_PORT
#   Port for the MCP HTTP server (sse / streamable-http transports).
#   Default: 3000 (8080 in the container image)
# -----------------------------------------------------------------------------
# AH_MCP_PORT=3000

# -----------------------------------------------------------------------------
# AH_TOKENS_PATH
#   Override the default XDG-compliant path for tokens.json.
#   Default (container): /data/ah-mcp/tokens.json
#   Default (Linux):     ~/.config/ah-mcp/tokens.json
#   Default (macOS):     ~/Library/Application Support/ah-mcp/tokens.json
#   Default (Windows):   %AppData%\ah-mcp\tokens.json
#   The directory is created automatically with mode 0700 if it does not exist.
#   The file is written with mode 0600 (owner read/write only).
# -----------------------------------------------------------------------------
# AH_TOKENS_PATH=/home/ah-mcp/.config/ah-mcp/tokens.json

# -----------------------------------------------------------------------------
# AH_MCP_OAUTH_ISSUER / AH_MCP_OAUTH_AUDIENCE
#   Enable OAuth (MCP authorization spec 2025-06-18) with Authentik as the
#   authorization server. Set both or neither.
#   ISSUER: exactly the tokens' "iss" claim, including the trailing slash
#           Authentik uses. Must be https.
#   AUDIENCE: the "aud" access tokens must carry — the provider's client ID.
#   Also set AH_MCP_BASE_URL to the public URL; clients are pointed at
#   <AH_MCP_BASE_URL>/.well-known/oauth-protected-resource.
# -----------------------------------------------------------------------------
# AH_MCP_OAUTH_ISSUER=https://authentik.example.com/application/o/ah-mcp/
# AH_MCP_OAUTH_AUDIENCE=

# -----------------------------------------------------------------------------
# AH_MCP_BIND
#   Interface the MCP HTTP server listens on — a host with no port.
#   Default: 127.0.0.1, or 0.0.0.0 when --remote / AH_REMOTE=true is set
#   (0.0.0.0 in the container image).
#   Requires AH_MCP_TOKEN or OAuth for anything but loopback.
# -----------------------------------------------------------------------------
# AH_MCP_BIND=0.0.0.0

# -----------------------------------------------------------------------------
# AH_REMOTE
#   Set to "true" to enable remote mode: binds all interfaces and returns a
#   login URL instead of opening a browser. Same as the --remote flag.
#   Default: false (true in the container image)
# -----------------------------------------------------------------------------
# AH_REMOTE=true

# -----------------------------------------------------------------------------
# AH_LOG_FILE
#   Optional log file path. Logs always go to stderr; when set they are also
#   appended here. Created with mode 0600. In the read-only container, point
#   it under /data (e.g. /data/ah-mcp.log) or leave it unset and use
#   `docker logs`.
# -----------------------------------------------------------------------------
# AH_LOG_FILE=/home/ah-mcp/ah-mcp.log

# -----------------------------------------------------------------------------
# AH_MCP_BASE_URL
#   Base URL advertised to MCP clients for the SSE endpoint, and added to the
#   default allowed origins.
#   Default: http://localhost:AH_MCP_PORT  (suitable for local use)
#   Override for remote deployments behind a reverse proxy:
#   e.g. https://ah-mcp.example.com
# -----------------------------------------------------------------------------
# AH_MCP_BASE_URL=https://ah-mcp.example.com
